# ==============================================================================
# INDIA BUSINESSVERSE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Note: Copy this file to .env and configure with your real values.
# NEVER commit .env or any real secrets to source control.

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=jdbc:postgresql://localhost:5432/businessverse
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here
DATABASE_SCHEMA=public

# Supabase Integration (Optional if using Supabase managed Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Backend Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI / LLM Configuration
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-pro
VECTOR_DATABASE_URL=postgresql://localhost:5432/businessverse_vectors

# Data Ingestion & Storage
MCA_DATA_DIR=./data/raw/mca
NSE_DATA_DIR=./data/raw/nse
PROVENANCE_REGISTRY_PATH=./data/provenance/registry.json
